{
    "name": "@hollymoon/marionette",
    "version": "0.0.14",
    "description": "Monorepo task orchestration framework",
    "author": "Takács Vilmos <tvili999@gmail.com>",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "marionette": "./dist/cli.mjs"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@10.30.3",
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "publint": "publint",
        "attw": "attw --pack .",
        "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm publint && pnpm attw",
        "prepack": "pnpm build"
    },
    "dependencies": {
        "@hollymoon/common": "^0.3.2",
        "@hollymoon/container": "^0.3.3"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.0.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.6",
        "publint": "^0.3.23",
        "tsdown": "^0.22.14",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.10"
    }
}
