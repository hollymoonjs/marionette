{
    "name": "@hollymoon/marionette",
    "version": "0.0.14",
    "description": "Monorepo task orchestration framework",
    "author": "Takács Vilmos <tvili999@gmail.com>",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./ui": {
            "import": {
                "types": "./dist/ui.d.mts",
                "default": "./dist/ui.mjs"
            },
            "require": {
                "types": "./dist/ui.d.cts",
                "default": "./dist/ui.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "ui": [
                "./dist/ui.d.cts"
            ]
        }
    },
    "bin": {
        "marionette": "./dist/cli.mjs"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "publint": "publint",
        "attw": "attw --pack .",
        "check": "pnpm typecheck && pnpm test && pnpm build && pnpm publint && pnpm attw",
        "prepack": "pnpm build"
    },
    "dependencies": {
        "@hollymoon/common": "^0.3.2",
        "@hollymoon/container": "^0.3.3"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@types/node": "^24.0.0",
        "publint": "^0.3.23",
        "tsdown": "^0.22.14",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    }
}
